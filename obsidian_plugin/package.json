{
  "name": "yami-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "The Yami showcase plugin: conversations with Claude Code and Codex, the built-in wiki and threads modules, and two views over the yami library.",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run test/unit",
    "test:obsidian": "vitest run test/obsidian"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2",
    "playwright-core": "^1.63.0",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "yami": "file:vendor/yami-0.18.1.tgz"
  }
}
