{
  "name": "yami",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Yami logic.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./agent/claude": {
      "types": "./dist/agent/claude.d.ts",
      "default": "./dist/agent/claude.js"
    },
    "./agent/codex": {
      "types": "./dist/agent/codex.d.ts",
      "default": "./dist/agent/codex.js"
    },
    "./document": {
      "types": "./dist/document/index.d.ts",
      "default": "./dist/document/index.js"
    },
    "./module": {
      "types": "./dist/module/index.d.ts",
      "default": "./dist/module/index.js"
    },
    "./modules/hello": {
      "types": "./dist/modules/hello.d.ts",
      "default": "./dist/modules/hello.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "test": "vitest run test/unit",
    "test:live": "vitest run test/live"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}
