{
  "name": "yami",
  "version": "0.12.0",
  "private": true,
  "description": "Yami: build agent workflows on session documents in an Obsidian vault. The agent harnesses, the documents, the wiki, the session runtime, and the Obsidian layer.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./agent/claude": {
      "types": "./dist/agent/claude.d.ts",
      "default": "./dist/agent/claude.js"
    },
    "./agent/codex": {
      "types": "./dist/agent/codex.d.ts",
      "default": "./dist/agent/codex.js"
    },
    "./document": {
      "types": "./dist/document/index.d.ts",
      "default": "./dist/document/index.js"
    },
    "./wiki": {
      "types": "./dist/wiki/index.d.ts",
      "default": "./dist/wiki/index.js"
    },
    "./conversation": {
      "types": "./dist/conversation/index.d.ts",
      "default": "./dist/conversation/index.js"
    },
    "./obsidian": {
      "types": "./dist/obsidian/index.d.ts",
      "default": "./dist/obsidian/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./esbuild": {
      "types": "./dist/build/esbuild.d.ts",
      "default": "./dist/build/esbuild.js"
    },
    "./markdown": {
      "types": "./markdown.d.ts"
    },
    "./obsidian/styles.css": "./src/obsidian/styles.css"
  },
  "files": [
    "dist",
    "src/obsidian/styles.css",
    "markdown.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.core.json && tsc",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "test": "tsc -p tsconfig.test.json && vitest run test/unit",
    "test:live": "vitest run test/live",
    "bench": "vitest run bench --disableConsoleIntercept"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "graphology-types": "^0.24.8",
    "happy-dom": "^21.0.3",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "diff-match-patch-es": "^2.0.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "monkey-around": "^3.0.0",
    "y-protocols": "^1.0.7",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  }
}
