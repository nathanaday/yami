{
  "name": "yami",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Yami logic.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./agent/claude": {
      "types": "./dist/agent/claude.d.ts",
      "default": "./dist/agent/claude.js"
    },
    "./agent/codex": {
      "types": "./dist/agent/codex.d.ts",
      "default": "./dist/agent/codex.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@openai/codex-sdk": "^0.162.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300"
  }
}
